{
  "compilerOptions": {
    "target": "ES2022",
    "composite": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": false,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "preserveWatchOutput": true,
    "skipLibCheck": true,
    "strict": false,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "lib": ["esnext"],
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": "."
  },

  "include": ["src"]
}
