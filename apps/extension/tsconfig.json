{
  "extends": ["@repo/typescript-config/wxt.json"],
  "compilerOptions": {
    "strictNullChecks": true,
    "strict": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": ["chrome"],
    "paths": {
      "@/*": ["./src/*"],
      "@entrypoints/*": ["./entrypoints/*"],
      "@repo/*": ["../../packages/*"]
    }
  },
  "include": [
    "./src/**/*",
    "./entrypoints/**/*",
    "./entrypoints/background.ts",
    "./types.d.ts",
    "./.wxt/**/*",
    "search-db.ts"
  ],
  "exclude": ["../.output", "./node_modules", "./chrome-data"]
}
